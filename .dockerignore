# Build context excludes. The Dockerfile runs `npm ci` + `npm run build`
# itself, so installed deps and build output must NOT be shipped in the context
# (that is what makes "transferring context" take minutes).

# Dependencies — root AND every nested workspace package (packages/lyrics/). The bare `node_modules` alone does not guarantee
# nested ones are excluded; `**/node_modules` does.
node_modules
**/node_modules

# Next.js / build output (regenerated by the build)
.next
**/.next
out
build
dist

# Version control + CI
.git
.github
.gitignore

# Env / secrets
.env
.env.*
!.env.example
.env.local

test-output

# Local data / SQLite
*.db
*.db-journal
*.sqlite
*.sqlite3

# Logs & scratch
*.log
dev-out.log
dev-err.log
npm-debug.log*

# Heavy media / archives (kept + extended)
*.thren
*.mp4
*.mov
*.webm
*.zip
midjourney_extracted

# Editor / OS / tooling
.vscode
.idea
.kiro
.DS_Store
Thumbs.db
coverage
.turbo
.vercel
